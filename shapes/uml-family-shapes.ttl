<https://mycr0ft.github.io/uml-ontology/shapes> a owl:Ontology ;
    rdfs:label "UML-family relationship shapes"@en ;
    rdfs:comment "Generated SHACL for the UML-family relationship ontology. Cardinality is the metamodel's own lo/hi; constraint facets come from a whitelisted OCL subset, and every refused constraint is listed in shapes/untranslated.json with its reason."@en ;
    owl:versionInfo "1" .

<https://mycr0ft.github.io/uml-ontology/shapes#bpmn_Activity> a sh:NodeShape ;
    sh:targetClass bpmn:Activity ;
    sh:property [ sh:path bpmn:Activity__loopCharacteristics ; sh:maxCount 1 ; umlmeta:grade "stated" ] ;
    sh:property [ sh:path bpmn:Activity__default ; sh:maxCount 1 ; umlmeta:grade "stated" ] ;
    sh:property [ sh:path bpmn:Activity__ioSpecification ; sh:maxCount 1 ; umlmeta:grade "stated" ] .

